---
import BaseLayout from '@/common/layouts/BaseLayout.astro';

interface Props {
  title?: string;
}

const { title = '' } = Astro.props;
---

<BaseLayout title={title} description={title}>
  <main class="page page-404" aria-label="Empty">
    <div class="not-found">
      <div class="not-found-icon" aria-hidden="true">
        <img src="/empty-logo.svg" alt="" />
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #263035;
    --surface: #f7f5ef;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--surface);
    color: var(--ink);
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(247, 245, 239, 0) 240px),
      var(--surface);
  }

  .page {
    display: grid;
    min-height: 100vh;
    place-items: center;
  }

  .not-found {
    display: grid;
    min-height: 96px;
    place-items: center;
  }

  .not-found-icon {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    opacity: 0.24;
  }

  .not-found-icon img {
    display: block;
    width: 56px;
    max-width: 56px;
    height: 56px;
    max-height: 56px;
  }
</style>
